<?php
$log = (string) @file_get_contents(dirname(__FILE__) . '/rfc1867_long_header.log.tmp');
var_dump(http_response_code());
var_dump($_POST);
var_dump(stripos($log, 'header') !== false);
var_dump(stripos($log, 'memory headroom') !== false);
?>
