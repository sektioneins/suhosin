--TEST--
rfc1867: an over-long MIME header drops the request and logs the real reason
--DESCRIPTION--
The multipart parser keeps at most 64 KB of a part header. A longer header
stops parsing, the form is dropped and the request is answered with 413.
The error log must name the over-long header as the reason, not memory
exhaustion. The Content-Type header below is folded over 70 lines of
1000 bytes each.
--INI--
suhosin.log.syslog=0
suhosin.log.sapi=0
suhosin.log.script=0
file_uploads=1
memory_limit=128M
date.timezone=UTC
error_log={PWD}/rfc1867_long_header.log.tmp
--SKIPIF--
<?php include('../skipif.inc'); ?>
--COOKIE--
--GET--
--POST_RAW--
